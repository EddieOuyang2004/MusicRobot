{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_matcher_experiment.schema.json",
  "title": "Humanoid Matcher Experiment Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_utc",
    "manifest",
    "protocol",
    "catalog",
    "quality",
    "audio_evaluation",
    "literature_motion_metrics",
    "runs",
    "trace_aggregates",
    "pose_aggregates",
    "response_latency",
    "ablation",
    "timing",
    "acceptance",
    "failures",
    "limitations",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_utc": {"type": "string"},
    "manifest": {"type": "object"},
    "protocol": {"type": "object"},
    "catalog": {"type": "object"},
    "quality": {"type": "object"},
    "audio_evaluation": {"type": "object"},
    "literature_motion_metrics": {"type": ["object", "null"]},
    "runs": {"type": "array", "items": {"type": "object"}},
    "trace_aggregates": {"type": "array", "items": {"type": "object"}},
    "pose_aggregates": {"type": "array", "items": {"type": "object"}},
    "response_latency": {"type": "array", "items": {"type": "object"}},
    "ablation": {"type": "object"},
    "timing": {"type": "object"},
    "acceptance": {"type": "object"},
    "failures": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": false
}
