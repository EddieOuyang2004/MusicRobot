        <mxCell id="title" value="Hierarchical Music-to-Motion Matching and Beat-Synchronous Humanoid Control" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172126;" vertex="1" parent="1"><mxGeometry x="270" y="15" width="1360" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Realtime Humanoid Matcher for AIST++ Retrieval, Motion Transition, and Unitree G1 Kinematic Playback" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#52636A;" vertex="1" parent="1"><mxGeometry x="420" y="55" width="1060" height="25" as="geometry"/></mxCell>

        <mxCell id="panelA" value="(A) Music Representation" style="swimlane;html=1;startSize=50;rounded=1;arcSize=8;horizontal=1;fillColor=#EDF9FB;swimlaneFillColor=#EDF9FB;strokeColor=#397F89;strokeWidth=2;fontSize=21;fontStyle=1;fontColor=#172126;shadow=1;" vertex="1" parent="1"><mxGeometry x="28" y="92" width="505" height="810" as="geometry"/></mxCell>
        <mxCell id="panelB" value="(B) Hierarchical Music-to-Motion Matcher" style="swimlane;html=1;startSize=50;rounded=1;arcSize=8;horizontal=1;fillColor=#EDF9FB;swimlaneFillColor=#EDF9FB;strokeColor=#397F89;strokeWidth=2;fontSize=21;fontStyle=1;fontColor=#172126;shadow=1;" vertex="1" parent="1"><mxGeometry x="572" y="92" width="728" height="810" as="geometry"/></mxCell>
