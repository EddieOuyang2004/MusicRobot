        <mxCell id="a0" value="🎙  &lt;b&gt;Live / File Audio Input&lt;/b&gt;&lt;br&gt;realtime microphone or virtual microphone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFB;strokeColor=#64757A;strokeWidth=1.5;fontSize=13;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="112" y="156" width="336" height="75" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;Robust Audio Preprocessing&lt;/b&gt;&lt;br&gt;16 kHz mono · DC removal · 95th-percentile gain normalization&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6 s rolling window · retrieval every 1 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.6;fontSize=13;spacing=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="105" y="258" width="350" height="76" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Content Encoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;DSP embedding (current)&lt;br&gt;optional Discogs-EffNet&lt;br&gt;&lt;i&gt;e ∈ ℝᵈ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.6;fontSize=13;spacing=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="62" y="368" width="214" height="142" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Rhythm–Timbre Encoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;BPM · onset · bands · MFCC&lt;br&gt;&lt;i&gt;r ∈ ℝ²⁴, p (optional)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.6;fontSize=13;spacing=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="301" y="368" width="194" height="142" as="geometry"/></mxCell>
        <mxCell id="concatA" value="+" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#397F89;strokeWidth=2;fontSize=24;fontColor=#397F89;" vertex="1" parent="1"><mxGeometry x="262" y="522" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;Query Audio Descriptor&lt;/b&gt;&lt;br&gt;&lt;i&gt;q = [e, r, p, BPM, activity]&lt;/i&gt;&lt;br&gt;▰▰▰▰▱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A8D6DC;strokeColor=#397F89;strokeWidth=1.7;fontSize=14;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="108" y="580" width="344" height="92" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;Realtime MusicFrame Stream&lt;/b&gt;&lt;br&gt;accepted beats · RMS · onset · brightness · frequency bands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFB;strokeColor=#64757A;strokeWidth=1.4;fontSize=13;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="108" y="696" width="344" height="70" as="geometry"/></mxCell>
        <mxCell id="a6" value="&lt;b&gt;Offline AIST++ Audio&lt;/b&gt;&lt;br&gt;same preprocessing and encoders → standardized catalog feature bank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7AD;strokeColor=#BD7224;strokeWidth=1.6;fontSize=13;spacing=7;shadow=1;" vertex="1" parent="1"><mxGeometry x="61" y="802" width="434" height="70" as="geometry"/></mxCell>

        <mxCell id="bBack2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9CCBD2;strokeColor=#397F89;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="642" y="171" width="574" height="257" as="geometry"/></mxCell>
        <mxCell id="bBack1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ACD6DC;strokeColor=#397F89;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="631" y="160" width="574" height="257" as="geometry"/></mxCell>
        <mxCell id="b0" value="&lt;b&gt;Segment-Level Similarity × N catalog segments&lt;/b&gt;" style="swimlane;html=1;startSize=48;rounded=1;horizontal=1;fillColor=#A8D6DC;swimlaneFillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.7;fontSize=15;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="149" width="574" height="257" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;Embedding Match&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sₑ = cos(eq, ei)&lt;/i&gt;&lt;br&gt;━━━━━━░" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFB;strokeColor=#64757A;strokeWidth=1.4;fontSize=13;spacing=5;" vertex="1" parent="1"><mxGeometry x="654" y="224" width="154" height="78" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Rhythm Match&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sᵣ = cos(rq, ri)&lt;/i&gt;&lt;br&gt;━━━━░░░" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFB;strokeColor=#64757A;strokeWidth=1.4;fontSize=13;spacing=5;" vertex="1" parent="1"><mxGeometry x="830" y="224" width="154" height="78" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Tag Match&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sₚ = cos(pq, pi)&lt;/i&gt;&lt;br&gt;━━━░░░░" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFB;strokeColor=#64757A;strokeWidth=1.4;fontSize=13;spacing=5;" vertex="1" parent="1"><mxGeometry x="1006" y="224" width="154" height="78" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;i&gt;Ssegment = .70Sₑ + .20Sᵣ + .10Sₚ&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;weights renormalized to .70 : .20 when tags are unavailable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A8D6DC;strokeColor=#397F89;strokeWidth=1.5;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="731" y="333" width="352" height="48" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Top-3 Segment Mean Pooling per Track&lt;/b&gt;&lt;br&gt;segment scores → music-level retrieval score Smusic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A8D6DC;strokeColor=#397F89;strokeWidth=1.6;fontSize=13;spacing=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="719" y="449" width="376" height="66" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;Top-K Retrieved Music Tracks&lt;/b&gt;&lt;br&gt;██████ ▓▓▓▓ ▒▒▒ ░░" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBE6E8;strokeColor=#596A70;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="720" y="546" width="374" height="47" as="geometry"/></mxCell>
        <mxCell id="headsTitle" value="Motion Compatibility Heads" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="616" width="294" height="30" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;Tempo Head&lt;/b&gt;&lt;br&gt;BPM ratio × speed bounds&lt;br&gt;&lt;i&gt;Stempo&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="627" y="657" width="168" height="93" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;Keypoint Head&lt;/b&gt;&lt;br&gt;beat / motion keypoint rate&lt;br&gt;&lt;i&gt;Skey&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="823" y="657" width="168" height="93" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;Activity Head&lt;/b&gt;&lt;br&gt;audio vs. motion energy&lt;br&gt;&lt;i&gt;Sactivity&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE9ED;strokeColor=#397F89;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1019" y="657" width="168" height="93" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;i&gt;Smotion = .50Stempo + .35Skey + .15Sactivity&lt;/i&gt;&lt;br&gt;&lt;b&gt;Final Motion Ranking&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sfinal = .55Smusic + .45Smotion&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A8D6DC;strokeColor=#397F89;strokeWidth=1.7;fontSize=14;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="690" y="776" width="434" height="96" as="geometry"/></mxCell>

        <mxCell id="c0" value="&lt;b&gt;Stable Motion Selector&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Relevance&lt;/b&gt;: margin ≥ .08, 3 wins&lt;br&gt;&lt;b&gt;Diversity&lt;/b&gt;: ≤ 4 bars, LRU near-best&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;switch only at a 4-beat bar boundary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7AD;strokeColor=#BD7224;strokeWidth=1.6;fontSize=13;spacing=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1383" y="166" width="225" height="155" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Ready Motion Pool&lt;/b&gt;&lt;br&gt;♙　♙　♙&lt;br&gt;preload · grounding · cache&lt;br&gt;canonical GMR–G1 trajectories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7AD;strokeColor=#BD7224;strokeWidth=1.6;fontSize=13;spacing=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1634" y="166" width="196" height="155" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Keypoint-Constrained Entry Pose Search&lt;/b&gt;&lt;br&gt;&lt;i&gt;J = .45Jpose + .20Jvel + .20Jcontact + .10Jroot + .05Jsalience&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;search keypoint neighborhoods (±3 frames); transition duration quantized to half-beats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7AD;strokeColor=#BD7224;strokeWidth=1.6;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1395" y="350" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Adaptive Beat–Phase Controller&lt;/b&gt;&lt;br&gt;strong-beat selection · tempo adaptation · gradual phase-error correction&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;phase · speed · amplitude · accent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#BD7224;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1395" y="468" width="420" height="88" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Root Alignment &amp; Cross-Motion Blending&lt;/b&gt;&lt;br&gt;joint interpolation · root-position blend · quaternion SLERP&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RootMotionContinuity preserves displacement and heading&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#BD7224;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1395" y="582" width="420" height="88" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Dynamics Limiter &amp; Collision Projection&lt;/b&gt;&lt;br&gt;joint speed / acceleration constraints · runtime self-collision check&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;safe RobotMotionFrame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7AD;strokeColor=#BD7224;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1395" y="696" width="420" height="88" as="geometry"/></mxCell>
        <mxCell id="c6" value="♙　&lt;b&gt;MuJoCo Unitree G1 · 29-DoF qpos Output&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kinematic playback via mj_forward (not torque or balance control)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7AD;strokeColor=#BD7224;strokeWidth=1.5;fontSize=13;spacing=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1395" y="807" width="420" height="67" as="geometry"/></mxCell>

